rules_version = '2';

// Per-user data isolation (NFR-04, NFR-06) — mirrors database-schema.md §8.2's
// collection/subcollection mapping. Every document under users/{userId} belongs
// to exactly one Firebase Auth user; nothing here is readable/writable cross-user.
//
// TODO: this is a scaffold only — tech-stack.md §7.2 flags that the actual rule
// set (equivalent to Supabase's former RLS) has not been designed yet.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollections: workoutSessions, weeklyPlanEntries, dayStatus,
      // dailyLogs, weightRecords (database-schema.md §8.2)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
