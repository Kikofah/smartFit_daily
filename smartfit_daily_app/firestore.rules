rules_version = '2';

// Deny-all for any Firestore client SDK (NFR-04, NFR-06 — defense in depth).
// Neither apps/web/client nor apps/mobile uses the Firestore client SDK —
// every read/write goes through apps/web/server's Express routes via the
// Admin SDK, which always bypasses these rules. So there is no legitimate
// client-side access to allow here; the Admin SDK server is the only
// intended accessor of this database.
//
// Revisit this (and design real per-collection rules) if a client ever reads
// Firestore directly instead of going through the server.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
