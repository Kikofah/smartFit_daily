{
  "name": "@smartfit/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "React Native + Expo client — screens mirror docs/02-design/01-prototypes/v1/.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
