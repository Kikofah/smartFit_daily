{
  "expo": {
    "name": "smartFit_daily Devices",
    "slug": "smartfit-daily-devices",
    "scheme": "smartfitdaily",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartfitdaily.devices"
    },
    "android": {
      "package": "com.smartfitdaily.devices",
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "อนุญาตให้ smartFit_daily เชื่อมต่อกับตาชั่งอัจฉริยะผ่าน Bluetooth"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "อนุญาตให้ smartFit_daily อ่านข้อมูลแคลอรี่ที่เผาผลาญจาก Apple Health"
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
