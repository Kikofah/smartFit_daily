# Copy this file to .env and fill in real values from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# .env is gitignored — never commit real values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Absolute URL of the apps/web Express server (see src/services/api.ts) —
# this app isn't served BY Express like the web client is, so it needs a
# real host, e.g. http://localhost:8080 for local dev.
EXPO_PUBLIC_API_BASE_URL=
