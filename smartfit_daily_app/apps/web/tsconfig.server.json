{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "outDir": "dist-server",
    "rootDir": "server",
    "types": ["node"]
  },
  "include": ["server"],
  // Test files are typechecked separately (tsconfig.server-tests.json) and
  // run by Vitest — keeping them out of this config means `build:server`
  // (tsc -p tsconfig.server.json, no --noEmit) never emits *.test.js into
  // dist-server.
  "exclude": ["**/*.test.ts"]
}
