{
  "name": "@smartfit/web",
  "version": "0.0.0",
  "private": true,
  "description": "Express server (API + static hosting) and React/Vite web client — see docs/02-design/01-prototypes/v1/ for the screens this mirrors.",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "cross-env API_PORT=8080 tsx watch server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@smartfit/shared-types": "*",
    "express": "^4.19.2",
    "firebase": "^10.12.0",
    "firebase-admin": "^12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-web": "~0.19.10",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
